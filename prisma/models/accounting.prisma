// All the accounting models are defined here. 
//This includes models for journal entries, financial statements, and related entities. 
// Each model is designed to capture the necessary details for accounting purposes, 
// ensuring accurate record-keeping and reporting.

enum VoucherType {
  SALES
  PURCHASE
  PAYMENT
  EXPENSE
  WAGE
  MEMOVOUCHER
}

// Pääluokan pääryhmä (tulotilit/menotilit/vastaavaa/vastattavaa) johdetaan
// sovelluskoodissa mainClass-arvosta, ei tallenneta erikseen tähän skeemaan.
//
// Tuloslaskelman pääluokat vastaavat yksi yhteen PMA:n (1753/2015) liitteen I
// kululajikohtaisen tuloslaskelmakaavan numeroituja eriä, ja ovat kaavan
// järjestyksessä: tilikartta ja tuloslaskelma lajittelevat enum-järjestyksen
// mukaan. Kaavan rakenne on src/lib/incomeStatementScheme.ts:ssä.
enum AccountMainClass {
  // Tuloslaskelma
  REVENUE // 1. Liikevaihto
  CHANGE_IN_FINISHED_GOODS_INVENTORIES // 2. Valmiiden ja keskeneräisten tuotteiden varastojen muutos
  PRODUCTION_FOR_OWN_USE // 3. Valmistus omaan käyttöön
  OTHER_OPERATING_INCOME // 4. Liiketoiminnan muut tuotot
  MATERIALS_AND_SERVICES // 5. Materiaalit ja palvelut
  PERSONNEL_EXPENSES // 6. Henkilöstökulut
  DEPRECIATION // 7. Poistot ja arvonalentumiset
  OTHER_OPERATING_EXPENSES // 8. Liiketoiminnan muut kulut
  FINANCIAL_INCOME_AND_EXPENSES // 10. Rahoitustuotot ja -kulut
  APPROPRIATIONS // 12. Tilinpäätössiirrot
  INCOME_TAXES // 13. Tuloverot
  OTHER_DIRECT_TAXES // 14. Muut välittömät verot

  // Tase: PMA:n liitteen V tasekaavan kirjaimin merkityt pääryhmät kaavan
  // järjestyksessä. Kaavan rakenne on src/lib/balanceSheetScheme.ts:ssä.

  // Vastaavaa
  FIXED_ASSETS // A Pysyvät vastaavat
  CURRENT_ASSETS // B Vaihtuvat vastaavat

  // Vastattavaa
  EQUITY // A Oma pääoma
  ACCUMULATED_APPROPRIATIONS // B Tilinpäätössiirtojen kertymä
  PROVISIONS // C Pakolliset varaukset
  LIABILITIES // D Vieras pääoma
}

// PMA:n liitteen V tasekaavan erät, joihin tiliryhmä voidaan kohdistaa. Erän
// pitää kuulua ryhmän pääluokkaan (tarkistetaan sovelluskoodissa, ks.
// balanceSheetItemBelongsTo). Kaava vaatii saamisista ja vieraasta pääomasta
// pitkäaikaisen osan erikseen, joten niiden erät ovat LONG_TERM_- ja
// SHORT_TERM_-pareina.
enum BalanceSheetItem {
  // A Pysyvät vastaavat, I Aineettomat hyödykkeet
  DEVELOPMENT_EXPENDITURE // 1. Kehittämismenot
  INTANGIBLE_RIGHTS // 2. Aineettomat oikeudet
  GOODWILL // 3. Liikearvo
  OTHER_INTANGIBLE_ASSETS // 4. Muut aineettomat hyödykkeet
  INTANGIBLE_ADVANCE_PAYMENTS // 5. Ennakkomaksut
  // II Aineelliset hyödykkeet
  LAND_AND_WATERS // 1. Maa- ja vesialueet
  BUILDINGS_AND_STRUCTURES // 2. Rakennukset ja rakennelmat
  MACHINERY_AND_EQUIPMENT // 3. Koneet ja kalusto
  OTHER_TANGIBLE_ASSETS // 4. Muut aineelliset hyödykkeet
  TANGIBLE_ADVANCE_PAYMENTS_AND_CONSTRUCTION_IN_PROGRESS // 5. Ennakkomaksut ja keskeneräiset hankinnat
  // III Sijoitukset
  INVESTMENT_HOLDINGS_IN_GROUP_UNDERTAKINGS // 1. Osuudet saman konsernin yrityksissä
  INVESTMENT_RECEIVABLES_FROM_GROUP_UNDERTAKINGS // 2. Saamiset saman konsernin yrityksiltä
  INVESTMENT_PARTICIPATING_INTERESTS // 3. Osuudet omistusyhteysyrityksissä
  INVESTMENT_RECEIVABLES_FROM_PARTICIPATING_INTERESTS // 4. Saamiset omistusyhteysyrityksiltä
  INVESTMENT_OTHER_SHARES_AND_HOLDINGS // 5. Muut osakkeet ja osuudet
  INVESTMENT_OTHER_RECEIVABLES // 6. Muut saamiset

  // B Vaihtuvat vastaavat, I Vaihto-omaisuus
  RAW_MATERIALS_AND_CONSUMABLES // 1. Aineet ja tarvikkeet
  WORK_IN_PROGRESS // 2. Keskeneräiset tuotteet
  FINISHED_GOODS // 3. Valmiit tuotteet/tavarat
  OTHER_INVENTORIES // 4. Muu vaihto-omaisuus
  INVENTORY_ADVANCE_PAYMENTS // 5. Ennakkomaksut
  // II Saamiset, pitkäaikaiset
  LONG_TERM_TRADE_RECEIVABLES // 1. Myyntisaamiset
  LONG_TERM_RECEIVABLES_FROM_GROUP_UNDERTAKINGS // 2. Saamiset saman konsernin yrityksiltä
  LONG_TERM_RECEIVABLES_FROM_PARTICIPATING_INTERESTS // 3. Saamiset omistusyhteysyrityksiltä
  LONG_TERM_LOAN_RECEIVABLES // 4. Lainasaamiset
  LONG_TERM_OTHER_RECEIVABLES // 5. Muut saamiset
  LONG_TERM_UNPAID_SHARES // 6. Maksamattomat osakkeet/osuudet
  LONG_TERM_PREPAYMENTS_AND_ACCRUED_INCOME // 7. Siirtosaamiset
  // II Saamiset, lyhytaikaiset
  SHORT_TERM_TRADE_RECEIVABLES
  SHORT_TERM_RECEIVABLES_FROM_GROUP_UNDERTAKINGS
  SHORT_TERM_RECEIVABLES_FROM_PARTICIPATING_INTERESTS
  SHORT_TERM_LOAN_RECEIVABLES
  SHORT_TERM_OTHER_RECEIVABLES
  SHORT_TERM_UNPAID_SHARES
  SHORT_TERM_PREPAYMENTS_AND_ACCRUED_INCOME
  // III Rahoitusarvopaperit
  SECURITIES_HOLDINGS_IN_GROUP_UNDERTAKINGS // 1. Osuudet saman konsernin yrityksissä
  SECURITIES_OTHER_SHARES_AND_HOLDINGS // 2. Muut osakkeet ja osuudet
  OTHER_SECURITIES // 3. Muut arvopaperit
  // IV Rahat ja pankkisaamiset
  CASH_AND_BANK

  // A Oma pääoma
  SHARE_CAPITAL // I Osake-, osuus- tai muu vastaava pääoma
  SHARE_PREMIUM_RESERVE // II Ylikurssirahasto
  REVALUATION_RESERVE // III Arvonkorotusrahasto
  // IV Muut rahastot
  INVESTED_UNRESTRICTED_EQUITY_RESERVE // 1. Sijoitetun vapaan oman pääoman rahasto
  RESERVE_FUND // 2. Vararahasto
  RESERVES_UNDER_ARTICLES // 3. Yhtiöjärjestyksen tai sääntöjen mukaiset rahastot
  FAIR_VALUE_RESERVE // 4. Käyvän arvon rahasto
  OTHER_RESERVES // 5. Muut rahastot
  RETAINED_EARNINGS // V Edellisten tilikausien voitto (tappio)
  PROFIT_FOR_THE_FINANCIAL_YEAR // VI Tilikauden voitto (tappio)

  // B Tilinpäätössiirtojen kertymä
  DEPRECIATION_DIFFERENCE // 1. Poistoero
  TAX_BASED_PROVISIONS // 2. Verotusperusteiset varaukset

  // C Pakolliset varaukset
  PENSION_PROVISIONS // 1. Eläkevaraukset
  TAX_PROVISIONS // 2. Verovaraukset
  OTHER_PROVISIONS // 3. Muut pakolliset varaukset

  // D Vieras pääoma, pitkäaikainen
  LONG_TERM_BONDS // 1. Joukkovelkakirjalainat
  LONG_TERM_CONVERTIBLE_BONDS // 2. Vaihtovelkakirjalainat
  LONG_TERM_LOANS_FROM_FINANCIAL_INSTITUTIONS // 3. Lainat rahoituslaitoksilta
  LONG_TERM_PENSION_LOANS // 4. Takaisinlainat työeläkevakuutuslaitoksilta
  LONG_TERM_ADVANCES_RECEIVED // 5. Saadut ennakot
  LONG_TERM_TRADE_PAYABLES // 6. Ostovelat
  LONG_TERM_BILLS_OF_EXCHANGE_PAYABLE // 7. Rahoitusvekselit
  LONG_TERM_LIABILITIES_TO_GROUP_UNDERTAKINGS // 8. Velat saman konsernin yrityksille
  LONG_TERM_LIABILITIES_TO_PARTICIPATING_INTERESTS // 9. Velat omistusyhteysyrityksille
  LONG_TERM_OTHER_LIABILITIES // 10. Muut velat
  LONG_TERM_ACCRUALS_AND_DEFERRED_INCOME // 11. Siirtovelat
  // D Vieras pääoma, lyhytaikainen
  SHORT_TERM_BONDS
  SHORT_TERM_CONVERTIBLE_BONDS
  SHORT_TERM_LOANS_FROM_FINANCIAL_INSTITUTIONS
  SHORT_TERM_PENSION_LOANS
  SHORT_TERM_ADVANCES_RECEIVED
  SHORT_TERM_TRADE_PAYABLES
  SHORT_TERM_BILLS_OF_EXCHANGE_PAYABLE
  SHORT_TERM_LIABILITIES_TO_GROUP_UNDERTAKINGS
  SHORT_TERM_LIABILITIES_TO_PARTICIPATING_INTERESTS
  SHORT_TERM_OTHER_LIABILITIES
  SHORT_TERM_ACCRUALS_AND_DEFERRED_INCOME
}

// PMA:n liitteen I tuloslaskelmakaavan kirjaimin merkityt alakohdat. Tiliryhmä
// voi kuulua yhteen alakohtaan; alakohdan pitää kuulua ryhmän pääluokkaan
// (tarkistetaan sovelluskoodissa, ks. subItemBelongsTo).
enum IncomeStatementSubItem {
  // 5. Materiaalit ja palvelut
  PURCHASES // a) aa) Ostot tilikauden aikana
  CHANGE_IN_INVENTORIES // a) ab) Varastojen muutos
  EXTERNAL_SERVICES // b) Ulkopuoliset palvelut

  // 6. Henkilöstökulut
  WAGES_AND_SALARIES // a) Palkat ja palkkiot
  PENSION_EXPENSES // b) ba) Eläkekulut
  OTHER_SOCIAL_SECURITY_EXPENSES // b) bb) Muut henkilösivukulut

  // 7. Poistot ja arvonalentumiset
  PLANNED_DEPRECIATION // a) Suunnitelman mukaiset poistot
  IMPAIRMENT_OF_FIXED_ASSETS // b) Arvonalentumiset pysyvien vastaavien hyödykkeistä
  EXCEPTIONAL_IMPAIRMENT_OF_CURRENT_ASSETS // c) Vaihtuvien vastaavien poikkeukselliset arvonalentumiset

  // 10. Rahoitustuotot ja -kulut. *_GROUP_UNDERTAKINGS-arvot ovat kaavan
  // "erikseen samaan konserniin kuuluvilta/kuuluville yrityksille" -erittelyjä.
  INCOME_FROM_GROUP_UNDERTAKINGS // a) Tuotot osuuksista saman konsernin yrityksissä
  INCOME_FROM_PARTICIPATING_INTERESTS // b) Tuotot osuuksista omistusyhteysyrityksissä
  INCOME_FROM_OTHER_FIXED_ASSET_INVESTMENTS // c) Tuotot muista pysyvien vastaavien sijoituksista
  INCOME_FROM_OTHER_FIXED_ASSET_INVESTMENTS_GROUP_UNDERTAKINGS
  OTHER_INTEREST_AND_FINANCIAL_INCOME // d) Muut korko- ja rahoitustuotot
  OTHER_INTEREST_AND_FINANCIAL_INCOME_GROUP_UNDERTAKINGS
  IMPAIRMENT_OF_FIXED_ASSET_INVESTMENTS // e) Arvonalentumiset pysyvien vastaavien sijoituksista
  IMPAIRMENT_OF_CURRENT_ASSET_SECURITIES // f) Arvonalentumiset vaihtuvien vastaavien rahoitusarvopapereista
  INTEREST_AND_OTHER_FINANCIAL_EXPENSES // g) Korkokulut ja muut rahoituskulut
  INTEREST_AND_OTHER_FINANCIAL_EXPENSES_GROUP_UNDERTAKINGS

  // 12. Tilinpäätössiirrot
  CHANGE_IN_DEPRECIATION_DIFFERENCE // a) Poistoeron muutos
  CHANGE_IN_TAX_BASED_PROVISIONS // b) Verotusperusteisten varausten muutos
  GROUP_CONTRIBUTION // c) Konserniavustus
}

// Tilikartta: jokaisella yrityksellä on täsmälleen yksi tilikartta, joka
// omistaa sen tiliryhmät ja tilit. Erillinen malli (companyId:n unique-rajoite)
// antaa tilikartalle oman identiteetin nyt ja tilaa laajentaa sitä myöhemmin
// (esim. nimi, kuvaus, lukitus) ilman että Account/AccountGroup-malleja pitää
// koskea uudestaan.
model ChartOfAccounts {
  id        String  @id @default(uuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  accountGroups AccountGroup[]
  accounts      Account[]

  // Tilit, joille kirjausrivien arvonlisävero kirjataan automaattisesti
  // (ks. src/lib/vat.ts): debet-rivin vero ALV-saamistilille, kredit-rivin vero
  // ALV-velkatilille. Null kunnes asetettu; oletustilikartta asettaa ne
  // tileille 1763 ja 2939. Restrict: käytössä olevaa ALV-tiliä ei voi poistaa
  // (ks. accountService.remove).
  vatReceivableAccountId String?
  vatReceivableAccount   Account? @relation("VatReceivableAccount", fields: [vatReceivableAccountId], references: [id], onDelete: Restrict)
  vatPayableAccountId    String?
  vatPayableAccount      Account? @relation("VatPayableAccount", fields: [vatPayableAccountId], references: [id], onDelete: Restrict)
  // Ostovelkatili, jolle hyväksytyn ostolaskun kokonaissumma kirjataan
  // (ks. src/lib/purchaseInvoice.ts). Null kunnes asetettu; oletustilikartta
  // asettaa sen tilille 2700. Restrict kuten ALV-tileillä.
  tradePayablesAccountId String?
  tradePayablesAccount   Account? @relation("TradePayablesAccount", fields: [tradePayablesAccountId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccountGroup {
  id        String           @id @default(uuid())
  name      String
  mainClass AccountMainClass
  // Tuloslaskelmakaavan alakohta. Null taseryhmillä, alakohdattomien erien
  // ryhmillä ja ryhmillä, joita ei ole vielä kohdistettu alakohtaan.
  incomeStatementSubItem IncomeStatementSubItem?
  // Tasekaavan erä. Null tuloslaskelmaryhmillä ja taseryhmillä, joita ei ole
  // vielä kohdistettu erään.
  balanceSheetItem BalanceSheetItem?
  companyId String
  company   Company          @relation(fields: [companyId], references: [id])
  accounts  Account[]

  // Denormalisoitu companyId:stä, kuten AccountingPeriod FiscalYearista:
  // kumpikin yrityksen tili/tiliryhmä kuuluu aina sen ainoaan tilikarttaan.
  chartOfAccountsId String
  chartOfAccounts   ChartOfAccounts @relation(fields: [chartOfAccountsId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([chartOfAccountsId])
}

model Account {
  id             String             @id @default(uuid())
  // Tilinumero on uniikki yrityksen sisällä (ei globaalisti): kahdella
  // yrityksellä voi olla oma tili 1900. Saldoa ei säilytetä kentässä, vaan se
  // johdetaan kirjausriveistä raportoinnissa.
  number         String
  name           String
  companyId      String
  company        Company            @relation(fields: [companyId], references: [id])
  accountGroupId String?
  accountGroup   AccountGroup?      @relation(fields: [accountGroupId], references: [id])
  // ALV-prosentti, jonka kirjausrivi saa oletuksena, kun tili valitaan sille
  // (ks. VAT_RATES, src/lib/vat.ts). Null = ei oletusta; 0 on oma arvonsa.
  // Pelkkä käyttöliittymän esitäyttö: palvelin ei johda rivin prosenttia
  // tästä, eikä oletusta käytetä, jos yritys ei ole arvonlisäverovelvollinen.
  defaultVatRate Float?
  journalEntries JournalEntry[]
  lines          JournalEntryLine[]

  bankAccounts BankAccount[]

  // Ks. AccountGroup.chartOfAccountsId.
  chartOfAccountsId String
  chartOfAccounts   ChartOfAccounts @relation(fields: [chartOfAccountsId], references: [id])

  // Ks. ChartOfAccounts.vatReceivableAccountId / vatPayableAccountId.
  vatReceivableFor ChartOfAccounts[] @relation("VatReceivableAccount")
  vatPayableFor    ChartOfAccounts[] @relation("VatPayableAccount")
  tradePayablesFor ChartOfAccounts[] @relation("TradePayablesAccount")

  // Ostolaskujen rivit ja toimittajat, joiden oletustili tämä on.
  purchaseInvoiceLines PurchaseInvoiceLine[]
  supplierDefaults     Supplier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@index([chartOfAccountsId])
}

model BankAccount {
    id        String    @id @default(uuid())
    name      String
    // Yksi IBAN per yritys, kuvattuna yhteen kirjanpitotiliin.
    iban      String
    companyId String
    company   Company   @relation(fields: [companyId], references: [id])
    accountId String
    account   Account   @relation(fields: [accountId], references: [id])
    // Käytöstä poistettu pankkitili säilyy (ja varaa IBANinsa), mutta sitä ei
    // tarjota uusiin valintoihin. Pankkitilejä ei poisteta, ne poistetaan
    // käytöstä ja voidaan ottaa takaisin käyttöön.
    isActive  Boolean   @default(true)

    statements BankStatement[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([companyId, iban])
    @@index([companyId])
}

// Tiliote: yrityksen tuoma PDF, jonka tapahtumat kirjataan käsin. Tiedoston
// sisältöä ei lueta, joten rivi tietää vain tiedoston, pankkitilin ja sen,
// onko tiliote merkitty kirjatuksi (ks. src/services/bank-statement.service.ts).
model BankStatement {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  // Tiliotteen PDF: yksi tiedosto on yksi tiliote. Restrict, koska tiedostoa
  // ei saa poistaa tiliotteen alta (ks. storedFileService.remove).
  fileId    String     @unique
  file      StoredFile @relation(fields: [fileId], references: [id], onDelete: Restrict)
  // Pankkitili, jonka tiliote tämä on; null kunnes käyttäjä valitsee sen.
  // Restrict (Prisman oletus valinnaiselle relaatiolle olisi SetNull):
  // pankkitilejä ei poisteta, eikä tiliote saa hiljaa menettää tiliään.
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  // Käyttäjän merkintä siitä, että tiliote on kirjattu. Pelkkä tila: se ei
  // lukitse kirjauksia, vaan sen tekevät tilikaudet ja jaksot.
  posted  Boolean        @default(false)
  entries JournalEntry[]
  // Tiliotteen tapahtumat, tuotu pankin CSV-tiedostosta.
  lines   BankStatementLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Palvelee yrityksen tiliotelistaa kirjaamattomat / kaikki -suodattimella.
  @@index([companyId, posted, createdAt])
}

// Tiliotteen tapahtuma: yksi rivi pankin CSV-tiedostosta (ks.
// src/lib/bankCsv.ts ja src/services/bank-statement-line.service.ts). Rivi
// kirjataan yhdeksi kirjaukseksi; kirjaus osoittaa rivin kirjatuksi.
model BankStatementLine {
  id              String        @id @default(uuid())
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id])
  // Cascade: rivit ovat tiliotteen tietoa eivätkä jää ilman sitä. (Tiliotteita
  // ei toistaiseksi poisteta lainkaan.)
  bankStatementId String
  bankStatement   BankStatement @relation(fields: [bankStatementId], references: [id], onDelete: Cascade)
  // Järjestys tiliotteella, vanhimmasta uusimpaan.
  position        Int
  // Kirjauspäivä ja arvopäivä (jos tiedostossa on), pelkkinä päivinä.
  bookingDate     DateTime      @db.Date
  valueDate       DateTime?     @db.Date
  // Etumerkillinen: + tilille tullut, - tililtä lähtenyt raha.
  amount              Float
  counterparty        String  @default("")
  counterpartyAccount String  @default("")
  reference           String  @default("")
  message             String  @default("")
  // Pankin tapahtumalaji tekstinä, esim. TILISIIRTO tai KORTTIOSTO.
  transactionType     String  @default("")
  // Pankin arkistointitunnus, jos tiedostossa on.
  archiveId           String?
  // Tunniste, jolla sama tapahtuma tunnistetaan uudesta tuonnista (ks.
  // dedupeKeys, src/lib/bankCsv.ts).
  dedupeKey           String
  // Kirjaus, johon rivi on kirjattu. SetNull: kirjauksen poisto palauttaa
  // rivin kirjaamattomaksi.
  journalEntryId      String?       @unique
  journalEntry        JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  // Tiliotteen rivit järjestyksessä; saman pankkitilin aiemmat rivit
  // tuplatarkistuksessa.
  @@index([bankStatementId, position])
  @@index([companyId, dedupeKey])
}

model JournalEntry {
  id            String             @id @default(uuid())
  voucherType   VoucherType
  // Juokseva tositenumero yrityksen ja tositelajin sisällä; allokoidaan
  // VoucherCounter-laskurista kirjausta luodessa, ei käyttäjän antama.
  voucherNumber Int
  // Kirjauspäivä; normalisoidaan UTC-keskiyöhön kirjoitettaessa (dateOnly.ts).
  date          DateTime
  description   String
  lines         JournalEntryLine[]
  accountId     String
  account       Account            @relation(fields: [accountId], references: [id])
  companyId     String
  company       Company            @relation(fields: [companyId], references: [id])

  // Tositteen liitteet (lasku, kuitti tms.), ks. prisma/models/storage.prisma.
  files StoredFile[]

  // Tiliote, jolta kirjaus on tehty, jos sellainen on. Asetetaan kirjausta
  // luodessa eikä muutu sen jälkeen. Restrict: tiliote, jolla on kirjauksia,
  // ei katoa niiden alta.
  bankStatementId String?
  bankStatement   BankStatement? @relation(fields: [bankStatementId], references: [id], onDelete: Restrict)
  // Tiliotteen tapahtuma, josta kirjaus on tehty, jos sellainen on.
  bankStatementLine BankStatementLine?
  // Ostolasku, jonka ostokirjaus tämä on, jos sellainen on. Sellaista
  // kirjausta muutetaan vain laskun kautta.
  purchaseInvoice   PurchaseInvoice?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@unique([companyId, voucherType, voucherNumber])
  @@index([companyId, date])
  // Tiliotteen kirjausten haku ja summaus.
  @@index([bankStatementId])
}

// Tositenumerosarjan laskuri per yritys ja tositelaji. Atominen upsert
// (INSERT ... ON CONFLICT DO UPDATE) sarjallistaa rinnakkaiset allokoinnit
// rivilukolla, eikä numeroita käytetä uudelleen vaikka kirjaus poistettaisiin.
model VoucherCounter {
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  voucherType VoucherType
  nextNumber  Int         @default(1)

  @@id([companyId, voucherType])
}

model JournalEntryLine {
  id             String       @id @default(uuid())
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  amount         Float
  description    String
  vatRate        Float
  vatAmount      Float
  type           String // "debit" or "credit"
  // True riveillä, jotka palvelin on generoinut toisen rivin verosta
  // ALV-tilille (ks. src/lib/vat.ts). Niitä ei koskaan oteta vastaan
  // asiakkaalta: ne luodaan uudestaan aina kun kirjaus tallennetaan.
  isVat          Boolean      @default(false)
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  // Valinnainen kustannuspaikka. Restrict (Prisman oletus valinnaiselle
  // relaatiolle olisi SetNull): käytössä olevaa kustannuspaikkaa ei voi
  // poistaa, eikä rivi saa hiljaa menettää sitä (ks. costCenterService.remove).
  costCenterId   String?
  costCenter     CostCenter?  @relation(fields: [costCenterId], references: [id], onDelete: Restrict)

  // Postgres does not index FK columns automatically. accountId serves the
  // general-ledger queries (per-account line fetch, opening-balance groupBy,
  // and the movement-in-range existence probe); journalEntryId serves the
  // deleteMany in entry update/remove and the journal list's line fan-out;
  // costCenterId serves the cost center report filters and the in-use check
  // on cost center delete.
  @@index([accountId])
  @@index([journalEntryId])
  @@index([costCenterId])
}

// Kustannuspaikka: kirjausrivin valinnainen seurantakohde. Koodi on uniikki
// yrityksen sisällä, kuten tilinumero.
model CostCenter {
  id        String             @id @default(uuid())
  code      String
  name      String
  companyId String
  company   Company            @relation(fields: [companyId], references: [id])
  lines     JournalEntryLine[]
  purchaseInvoiceLines PurchaseInvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}
