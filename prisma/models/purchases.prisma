// Ostot: toimittajat ja ostolaskut (ks. src/services/supplier.service.ts ja
// src/services/purchase-invoice.service.ts).

// Toimittaja, jolta yritys ostaa. Pankkitiedot, oletustili ja oletus-ALV ovat
// pelkkiä käyttöliittymän esitäyttöjä uusille laskuille: palvelin ei kopioi
// niitä laskulle.
model Supplier {
  id         String  @id @default(uuid())
  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  name       String
  // Y-tunnus, kun maa on FI (muoto ja tarkiste tarkistetaan, ks.
  // src/lib/businessId.ts); muuten vapaata tekstiä. Uniikki yrityksen sisällä,
  // kun annettu: Postgresin unique ei törmää NULL-arvoihin.
  businessId String?
  // ALV-numero (esim. FI12345678), välilyönnit poistettuna ja isoin kirjaimin.
  vatNumber  String?

  email         String?
  phone         String?
  streetAddress String?
  postalCode    String?
  city          String?
  // ISO 3166-1 alpha-2 -maakoodi.
  country       String  @default("FI")

  // Oletuspankkitiedot uusille laskuille, normalisoituina (ks. src/lib/iban.ts).
  iban             String?
  bic              String?
  // Oletustili ja -ALV uusien laskurivien esitäyttöön. SetNull: tilin
  // poistaminen vain poistaa oletuksen.
  defaultAccountId String?
  defaultAccount   Account? @relation(fields: [defaultAccountId], references: [id], onDelete: SetNull)
  // Yksi VAT_RATES-arvoista (src/lib/vat.ts) tai null = ei oletusta.
  defaultVatRate   Float?

  invoices PurchaseInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, businessId])
  @@index([companyId, name])
}

enum PurchaseInvoiceStatus {
  NEW // Saapunut, muokattavissa; ei vielä kirjanpidossa
  APPROVED // Hyväksytty: ostokirjaus (PURCHASE) on tehty
  PAID // Hyväksytty ja merkitty maksetuksi (pelkkä merkintä)
  REJECTED // Hylätty; ei koskaan kirjanpidossa
}

// Ostolasku. Laskulla on omat tiliöintirivinsä (kulupuoli); vastakirjaus
// ostovelkoihin on implisiittinen. Kirjanpitoon lasku menee vasta
// hyväksyttäessä, jolloin riveistä tehdään ostokirjaus (ks.
// src/lib/purchaseInvoice.ts).
model PurchaseInvoice {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  // Toimittajan laskunumero.
  invoiceNumber    String
  // Viitenumero tai RF-viite normalisoituna (ks. src/lib/paymentReference.ts).
  paymentReference String?

  // Pelkkiä päiviä (ks. src/lib/dateOnly.ts). entryDate on ostokirjauksen
  // kirjauspäivä.
  invoiceDate DateTime @db.Date
  entryDate   DateTime @db.Date
  dueDate     DateTime @db.Date

  iban        String?
  bic         String?
  description String  @default("")

  // Miten rivien summat syötettiin: "net" tai "gross" (ks. VatBasis,
  // src/lib/vat.ts). Rivit tallennetaan verottomina kuten kirjausrivit;
  // peruste säilytetään, jotta hyväksyntä tuottaa täsmälleen samat sentit ja
  // käyttöliittymä voi näyttää rivit syötetyssä muodossa.
  vatBasis String @default("net")

  // Laskun verollinen loppusumma sellaisena kuin se luettiin laskulta.
  // Laskulista näyttää, lajittelee ja hakee sen mukaan; hyväksyntä vaatii, että
  // rivien verollinen summa (invoiceTotals, src/lib/purchaseInvoice.ts) on
  // sentilleen sama.
  totalAmount Float

  status PurchaseInvoiceStatus @default(NEW)
  lines  PurchaseInvoiceLine[]
  // Laskun liitteet. Hyväksyttäessä ne liitetään myös ostokirjaukseen.
  files  StoredFile[]

  // Ostokirjaus, asetettu tiloissa APPROVED ja PAID. Restrict: kirjausta ei
  // poisteta laskun alta (palautus NEW-tilaan poistaa sen hallitusti).
  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  createdById     String
  createdBy       User      @relation("PurchaseInvoicesCreated", fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?     @relation("PurchaseInvoicesApproved", fields: [approvedById], references: [id])
  approvedAt      DateTime?
  rejectedById    String?
  rejectedBy      User?     @relation("PurchaseInvoicesRejected", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?
  paidById        String?
  paidBy          User?     @relation("PurchaseInvoicesPaid", fields: [paidById], references: [id])
  paidAt          DateTime?
  paymentDate     DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sama laskunumero samalta toimittajalta on kaksoiskappale.
  @@unique([companyId, supplierId, invoiceNumber])
  // Laskulista tilan ja eräpäivän mukaan.
  @@index([companyId, status, dueDate])
  @@index([supplierId])
}

// Ostolaskun tiliöintirivi: kulupuolen tili, veroton summa ja sen vero.
model PurchaseInvoiceLine {
  id                String          @id @default(uuid())
  companyId         String
  company           Company         @relation(fields: [companyId], references: [id])
  // Cascade: rivit ovat laskun tietoa.
  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  // Järjestys laskulla.
  position          Int
  accountId         String
  account           Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  // Veroton summa ja sen vero, kuten JournalEntryLine.
  amount            Float
  vatRate           Float
  vatAmount         Float
  description       String          @default("")
  costCenterId      String?
  costCenter        CostCenter?     @relation(fields: [costCenterId], references: [id], onDelete: Restrict)

  @@index([purchaseInvoiceId, position])
  @@index([accountId])
  @@index([costCenterId])
}
