// companies models

model Company {
  id                 String             @id @default(uuid())
  name               String
  businessId           String             @unique
  billingEmail       String
  billingAddress     String
  billingCity        String
  billingPostalCode  String
  billingCountry     String
  subscriptionStatus SubscriptionStatus @default(PENDING_PAYMENT)
  subscriptionEndsAt DateTime? // manual activation sets this; Stripe will manage it later
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  members            CompanyUser[]
  invitations        CompanyInvitation[]
  settings           CompanySettings?
  chartOfAccounts    ChartOfAccounts?
  accountGroups      AccountGroup[]
  accounts           Account[]
  journalEntries     JournalEntry[]
  bankAccounts       BankAccount[]
  bankStatements     BankStatement[]
  bankStatementLines BankStatementLine[]
  storedFiles        StoredFile[]
  fiscalYears        FiscalYear[]
  accountingPeriods  AccountingPeriod[]
  voucherCounters    VoucherCounter[]
  costCenters        CostCenter[]
  suppliers            Supplier[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
}

// Settings of the company's books. Keyed by the company alone, so they apply to
// everyone working in it (personal preferences never go here). The row is
// created lazily on the first save: no row means all defaults (see
// src/services/company-settings.service.ts).
model CompanySettings {
  companyId     String   @id
  // Whether the company is registered for VAT (arvonlisäverovelvollinen). When
  // it is not, no journal entry line may carry a VAT rate.
  vatRegistered Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// Membership of a user in a company. Role and admin rights are per-company:
// the same user can be ADMIN in their own company and VIEWER in a client's.
model CompanyUser {
  userId    String
  companyId String
  role      Role     @default(VIEWER) // accounting access level within this company
  isAdmin   Boolean  @default(false) // company administrator (employees/billing)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([userId, companyId])
  @@index([companyId])
}

// An invitation for a user who already has an account to join a company,
// waiting in that user's inbox. A row exists only while the invitation is
// pending: accepting turns it into a CompanyUser with the role and
// administrator flag recorded here, declining or cancelling deletes it.
model CompanyInvitation {
  id          String   @id @default(uuid())
  userId      String // the invited user
  companyId   String
  role        Role     @default(VIEWER)
  isAdmin     Boolean  @default(false)
  invitedById String? // the company administrator who sent it
  createdAt   DateTime @default(now())
  user        User     @relation("InvitationsReceived", fields: [userId], references: [id], onDelete: Cascade)
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy   User?    @relation("InvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([userId, companyId])
  @@index([companyId])
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  PAST_DUE
  CANCELED
}
