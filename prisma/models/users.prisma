// users models
model User {
  id              String    @id @default(uuid())
  firstName       String
  lastName        String
  email           String    @unique
  password_hash   String
  // Set for an account a company administrator created with a temporary
  // password: until the user has set a password of their own, only the auth
  // routes answer them (src/middleware/requirePasswordChanged.ts).
  mustChangePassword Boolean @default(false)
  phone           String?
  emailVerifiedAt DateTime?
  lastLogged      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // A user can belong to multiple companies; role/isAdmin live on the
  // CompanyUser membership (per-company facts, not global user facts).
  memberships    CompanyUser[]
  // Invitations to companies waiting for this user's answer, and those this
  // user has sent as a company administrator.
  invitations     CompanyInvitation[] @relation("InvitationsReceived")
  invitationsSent CompanyInvitation[] @relation("InvitationsSent")
  settings       UserSettings?
  sessions       Session[]
  tokens         VerificationToken[]
  journalEntries JournalEntry[]
  uploadedFiles  StoredFile[]
}

// Personal preferences. Keyed by the user alone, so they follow the user into
// every company they belong to (company-specific settings never go here). The
// row is created lazily on the first save: no row means all defaults (see
// src/services/user-settings.service.ts).
model UserSettings {
  userId    String   @id
  language  String   @default("fi") // UI language; validated against SUPPORTED_LANGUAGES
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  VIEWER
  LEDGER
  ACCOUNTANT
  ADMIN
}
