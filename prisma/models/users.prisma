// users models
model User {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String   @unique
  password_hash  String
  phone     String?
  Role      Role     @default(VIEWER)
  lastLogged DateTime?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  VIEWER
  LEDGER
  ACCOUNTANT
  ADMIN
}
