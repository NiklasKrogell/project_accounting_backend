// auth models — sessions and one-time verification tokens

model Session {
  id              String   @id @default(uuid())
  tokenHash       String   @unique // sha256 of the cookie token — the raw token is never stored
  userId          String
  activeCompanyId String? // which company this session is currently operating in
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Single-use tokens for email verification and password reset.
model VerificationToken {
  id        String       @id @default(uuid())
  tokenHash String       @unique
  userId    String
  purpose   TokenPurpose
  expiresAt DateTime
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}
