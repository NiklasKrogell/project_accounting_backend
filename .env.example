PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/project_accounting?schema=public
CORS_ORIGIN=http://localhost:3000
# The reverse proxy in front of the server. Leave unset when there is none
# (development). In production either the number of proxies in the chain
# (TRUST_PROXY=1) or their addresses (TRUST_PROXY=loopback or
# TRUST_PROXY=10.0.0.0/8,192.168.1.5). See src/lib/trustProxy.ts.
# TRUST_PROXY=
# Object storage (S3 API). These point at the S3Mock container of
# docker-compose.yml, which takes any credentials. Production is Cloudflare R2:
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com (with .eu before
# .r2 for a bucket in the EU jurisdiction) and S3_REGION=auto.
S3_ENDPOINT=http://localhost:9090
S3_REGION=auto
S3_BUCKET=project-accounting-dev
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
